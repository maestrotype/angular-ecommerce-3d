{
  "name": "angular-ecommerce-3d",
  "defaultProject": "angular-ecommerce-3d",
  "version": "1.0.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production && ng run angular-ecommerce-3d:server:production",
    "serve:ssr:dev": "npm run build:prod && PORT=4000 node server-simple.mjs",
    "serve:ssr": "node server-simple.mjs",
    "serve:ssr:prod": "NODE_ENV=production node server-simple.mjs",
    "deploy": "npm run build:prod && (npm run build:gh && npx angular-cli-ghpages --dir=dist/angular-ecommerce-3d/browser) && echo '🚀 SSR Built & GitHub Pages Updated.'",
    "deploy:ssr": "ng build --configuration production && ng run angular-ecommerce-3d:server:production && echo '⚙️ SSR Build Complete.'",
    "deploy:pwa": "npm run deploy:legacy",
    "deploy:legacy": "npm run build:gh && npx angular-cli-ghpages --dir=dist/angular-ecommerce-3d/browser",
    "build:gh": "ng build --configuration production --base-href=/angular-ecommerce-3d/",
    "test": "jest",
    "e2e": "playwright test e2e/smoke.spec.ts",
    "screenshots:capture": "playwright test e2e/capture-screenshots.spec.ts --project=chromium",
    "docs:client": "node scripts/build-client-docs.cjs",
    "demo:models": "node scripts/download-demo-models.mjs"
  },
  "dependencies": {
    "@abacritt/angularx-social-login": "^1.2.5",
    "@angular/animations": "^17.3.0",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/material": "^17.3.10",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/platform-server": "^17.3.12",
    "@angular/router": "^17.3.0",
    "@angular/service-worker": "^17.3.0",
    "@angular/ssr": "^17.3.17",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "@stripe/stripe-js": "^7.8.0",
    "chart.js": "^4.5.1",
    "express": "^4.22.1",
    "ng2-charts": "^6.0.1",
    "rxjs": "^7.8.1",
    "three": "^0.158.0",
    "zone.js": "^0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.12",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.12",
    "@playwright/test": "^1.58.2",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@types/three": "^0.158.0",
    "angular-cli-ghpages": "^2.0.3",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.0.0",
    "playwright": "^1.58.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "webpack": "^5.92.1"
  }
}
